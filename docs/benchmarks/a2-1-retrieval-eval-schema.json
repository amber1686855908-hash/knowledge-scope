{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledgescope.local/schemas/a2-1-retrieval-eval-item.json",
  "title": "KnowledgeScope A2.1 Retrieval Evaluation Item",
  "description": "Repository-safe contract for canonical-evidence text retrieval annotations. query_source is audit-only; answer evidence is authoritative gold relevance. Runtime chunks are derived and are not part of the annotation identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item_id",
    "query",
    "subject",
    "query_type",
    "verification_status",
    "evidence",
    "query_source",
    "evidence_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "item_id": {
      "type": "string",
      "pattern": "^a2-1-[0-9a-f]{64}$"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "query_type": {
      "enum": [
        "factual",
        "definition",
        "explanation",
        "comparison",
        "formula_or_table",
        "cross_block"
      ]
    },
    "verification_status": {
      "enum": [
        "candidate",
        "verified",
        "rejected"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_location"
      }
    },
    "query_source": {
      "type": "array",
      "description": "Optional canonical location of the textbook question; never used as gold relevance.",
      "items": {
        "$ref": "#/$defs/evidence_location"
      }
    },
    "evidence_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "evidence_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "page_number",
        "source_block_ids"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "source_block_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
