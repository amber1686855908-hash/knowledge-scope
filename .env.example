# Copy this file to .env for local configuration. Do not put secrets here.
KNOWLEDGE_SCOPE_PROJECT_NAME=KnowledgeScope
KNOWLEDGE_SCOPE_ENVIRONMENT=development
KNOWLEDGE_SCOPE_LOG_LEVEL=INFO
KNOWLEDGE_SCOPE_DATA_DIR=data
KNOWLEDGE_SCOPE_MAX_UPLOAD_SIZE_BYTES=52428800
KNOWLEDGE_SCOPE_CORS_ORIGINS=["http://localhost:5173"]
KNOWLEDGE_SCOPE_POSTGRES_PORT=5433
KNOWLEDGE_SCOPE_DATABASE_URL=postgresql+asyncpg://knowledgescope:knowledgescope@127.0.0.1:5433/knowledgescope
KNOWLEDGE_SCOPE_MINERU_COMMAND=mineru
KNOWLEDGE_SCOPE_MINERU_TIMEOUT_SECONDS=1800
KNOWLEDGE_SCOPE_QDRANT_URL=http://127.0.0.1:6333
KNOWLEDGE_SCOPE_QDRANT_PORT=6333
# Optional local-development API key. Do not commit real secrets.
KNOWLEDGE_SCOPE_QDRANT_API_KEY=
KNOWLEDGE_SCOPE_QDRANT_TIMEOUT_SECONDS=10
KNOWLEDGE_SCOPE_QDRANT_UPSERT_BATCH_SIZE=128
KNOWLEDGE_SCOPE_QDRANT_COLLECTION_NAME=knowledgescope_chunks_v1
KNOWLEDGE_SCOPE_EMBEDDING_DEVICE=cuda
KNOWLEDGE_SCOPE_EMBEDDING_DTYPE=float16
KNOWLEDGE_SCOPE_EMBEDDING_BATCH_SIZE=4
KNOWLEDGE_SCOPE_EMBEDDING_MAX_SEQ_LENGTH=512
KNOWLEDGE_SCOPE_EMBEDDING_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
