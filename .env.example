# Copy this file to .env for local configuration. Do not put secrets here.
KNOWLEDGE_SCOPE_PROJECT_NAME=KnowledgeScope
KNOWLEDGE_SCOPE_ENVIRONMENT=development
KNOWLEDGE_SCOPE_LOG_LEVEL=INFO
KNOWLEDGE_SCOPE_DATA_DIR=data
KNOWLEDGE_SCOPE_MAX_UPLOAD_SIZE_BYTES=52428800
KNOWLEDGE_SCOPE_CORS_ORIGINS=["http://localhost:5173"]
KNOWLEDGE_SCOPE_POSTGRES_PORT=5433
KNOWLEDGE_SCOPE_DATABASE_URL=postgresql+asyncpg://knowledgescope:knowledgescope@127.0.0.1:5433/knowledgescope
KNOWLEDGE_SCOPE_MINERU_COMMAND=mineru
KNOWLEDGE_SCOPE_MINERU_TIMEOUT_SECONDS=1800
KNOWLEDGE_SCOPE_QDRANT_URL=http://127.0.0.1:6333
KNOWLEDGE_SCOPE_QDRANT_PORT=6333
# Optional local-development API key. Do not commit real secrets.
KNOWLEDGE_SCOPE_QDRANT_API_KEY=
KNOWLEDGE_SCOPE_QDRANT_TIMEOUT_SECONDS=10
KNOWLEDGE_SCOPE_QDRANT_UPSERT_BATCH_SIZE=128
KNOWLEDGE_SCOPE_QDRANT_COLLECTION_NAME=knowledgescope_chunks_v1
KNOWLEDGE_SCOPE_QDRANT_REPRESENTATION_COLLECTION_NAME=knowledgescope_representations_v1
# Neo4j is optional for the current API; configure this local-only value before using its CLI.
KNOWLEDGE_SCOPE_NEO4J_URI=bolt://127.0.0.1:7687
KNOWLEDGE_SCOPE_NEO4J_USERNAME=neo4j
# Compose uses a local development default when this remains empty; never commit real credentials.
KNOWLEDGE_SCOPE_NEO4J_PASSWORD=
KNOWLEDGE_SCOPE_NEO4J_DATABASE=neo4j
KNOWLEDGE_SCOPE_NEO4J_TIMEOUT_SECONDS=10
KNOWLEDGE_SCOPE_EMBEDDING_DEVICE=cuda
KNOWLEDGE_SCOPE_EMBEDDING_DTYPE=float16
KNOWLEDGE_SCOPE_EMBEDDING_BATCH_SIZE=4
KNOWLEDGE_SCOPE_EMBEDDING_MAX_SEQ_LENGTH=512
KNOWLEDGE_SCOPE_EMBEDDING_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
KNOWLEDGE_SCOPE_RERANKER_MODEL_KEY=qwen3-reranker-0.6b
KNOWLEDGE_SCOPE_RERANKER_DEVICE=cuda
KNOWLEDGE_SCOPE_RERANKER_DTYPE=float16
KNOWLEDGE_SCOPE_RERANKER_BATCH_SIZE=4
KNOWLEDGE_SCOPE_RERANKER_MAX_SEQ_LENGTH=512
# Optional revision pin; leave blank to use the model's current default revision.
KNOWLEDGE_SCOPE_RERANKER_MODEL_REVISION=
KNOWLEDGE_SCOPE_LLM_PROVIDER=deepseek
KNOWLEDGE_SCOPE_LLM_BASE_URL=https://api.deepseek.com
# Optional provider key. Keep this empty in the committed example.
KNOWLEDGE_SCOPE_LLM_API_KEY=
KNOWLEDGE_SCOPE_LLM_MODEL=deepseek-chat
KNOWLEDGE_SCOPE_LLM_TIMEOUT_SECONDS=60
KNOWLEDGE_SCOPE_LLM_MAX_RETRIES=0
# Optional prices per 1,000 tokens; empty values disable cost estimation.
KNOWLEDGE_SCOPE_LLM_INPUT_COST_PER_1K_TOKENS=
KNOWLEDGE_SCOPE_LLM_OUTPUT_COST_PER_1K_TOKENS=
KNOWLEDGE_SCOPE_GRAPH_EXTRACTION_MAX_TOKENS=1024
KNOWLEDGE_SCOPE_GRAPH_EXTRACTION_MAX_PARSE_RETRIES=1
# Bounded finish_reason=length escalation; the first value must match the initial budget.
KNOWLEDGE_SCOPE_GRAPH_EXTRACTION_TRUNCATION_BUDGETS=[1024,2048,4096]
KNOWLEDGE_SCOPE_RAG_CANDIDATE_LIMIT=10
KNOWLEDGE_SCOPE_RAG_RERANK_LIMIT=5
KNOWLEDGE_SCOPE_RAG_CONTEXT_BUDGET_CHARS=6000
KNOWLEDGE_SCOPE_RAG_MAX_TOKENS=512
KNOWLEDGE_SCOPE_GRAPH_RETRIEVAL_MAX_SEED_ENTITIES=5
KNOWLEDGE_SCOPE_GRAPH_RETRIEVAL_MAX_HOPS=2
KNOWLEDGE_SCOPE_GRAPH_RETRIEVAL_MAX_NEIGHBORS=20
KNOWLEDGE_SCOPE_GRAPH_RETRIEVAL_MAX_RELATIONS=100
KNOWLEDGE_SCOPE_GRAPH_RETRIEVAL_MAX_EVIDENCE=50
KNOWLEDGE_SCOPE_GRAPH_RETRIEVAL_MAX_ENTITY_SCAN=10000
KNOWLEDGE_SCOPE_GRAPH_RETRIEVAL_LEXICAL_THRESHOLD=0.78
KNOWLEDGE_SCOPE_HYBRID_RRF_K=60
KNOWLEDGE_SCOPE_HYBRID_VECTOR_CANDIDATE_LIMIT=20
KNOWLEDGE_SCOPE_HYBRID_VECTOR_RERANK_LIMIT=10
KNOWLEDGE_SCOPE_HYBRID_GRAPH_RESULT_LIMIT=20
KNOWLEDGE_SCOPE_HYBRID_RESULT_LIMIT=20
KNOWLEDGE_SCOPE_HYBRID_FAILURE_MODE=degraded
KNOWLEDGE_SCOPE_SPARSE_INDEX_PATH=data/evaluation/a4-3/sparse.sqlite3
KNOWLEDGE_SCOPE_SPARSE_BM25_K1=1.2
KNOWLEDGE_SCOPE_SPARSE_BM25_B=0.75
# Unified A4.4 branch/pool bounds; the final reranker is the BGE model selected in A2.4.
KNOWLEDGE_SCOPE_UNIFIED_DENSE_CANDIDATE_LIMIT=20
KNOWLEDGE_SCOPE_UNIFIED_SPARSE_CANDIDATE_LIMIT=20
KNOWLEDGE_SCOPE_UNIFIED_GRAPH_CANDIDATE_LIMIT=20
KNOWLEDGE_SCOPE_UNIFIED_MULTIMODAL_CANDIDATE_LIMIT=20
KNOWLEDGE_SCOPE_UNIFIED_CANDIDATE_POOL_LIMIT=80
KNOWLEDGE_SCOPE_UNIFIED_RESULT_LIMIT=20
KNOWLEDGE_SCOPE_UNIFIED_RERANK_TEXT_MAX_CHARS=6000
KNOWLEDGE_SCOPE_UNIFIED_FAILURE_MODE=degraded
# ChatBI policy and schema-discovery defaults; datasource refs point to external config/secrets.
KNOWLEDGE_SCOPE_CHATBI_MAX_ROWS=1000
KNOWLEDGE_SCOPE_CHATBI_MAX_RESULT_BYTES=4000000
KNOWLEDGE_SCOPE_CHATBI_MAX_CELL_BYTES=1000000
KNOWLEDGE_SCOPE_CHATBI_MAX_NESTED_VALUE_DEPTH=32
KNOWLEDGE_SCOPE_CHATBI_MAX_COLLECTION_ITEMS=10000
KNOWLEDGE_SCOPE_CHATBI_STATEMENT_TIMEOUT_MS=30000
KNOWLEDGE_SCOPE_CHATBI_SCHEMA_CONNECTION_TIMEOUT_SECONDS=10
KNOWLEDGE_SCOPE_CHATBI_SCHEMA_CONTEXT_MAX_CHARS=24000
KNOWLEDGE_SCOPE_CHATBI_ALLOWED_SCHEMAS=["public"]
KNOWLEDGE_SCOPE_CHATBI_ALLOW_VIEWS=false
KNOWLEDGE_SCOPE_CHATBI_NL2SQL_MAX_TOKENS=1024
KNOWLEDGE_SCOPE_CHATBI_AGENT_MAX_SQL_ATTEMPTS=2
KNOWLEDGE_SCOPE_CHATBI_AGENT_MAX_REPAIR_ATTEMPTS=1
KNOWLEDGE_SCOPE_CHATBI_AGENT_MAX_STEPS=6
KNOWLEDGE_SCOPE_CHATBI_AGENT_MAX_LLM_CALLS=3
KNOWLEDGE_SCOPE_CHATBI_ANALYSIS_MAX_TOKENS=1024
# Optional: required only for the authoritative provider-backed A5.7 demo evaluation.
# This must identify the registered, isolated chatbi_demo datasource; it is not a secret.
KNOWLEDGE_SCOPE_CHATBI_EVALUATION_DATASOURCE_ID=
# Maximum concurrent MCP tool calls in the local stdio process.
KNOWLEDGE_SCOPE_MCP_MAX_IN_FLIGHT=4
